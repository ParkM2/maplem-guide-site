---
import '../../styles/global.css';
import '../../admin/admin.css';
import { SITE_NAME } from '../../lib/site';
import ThemeHead from '../../components/ThemeHead.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <ThemeHead />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title>글쓰기 · {SITE_NAME}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;600;700&display=swap" />
</head>
<body class="admin">
  <header class="wr-head">
    <a class="logo" href="/admin/">메이플스토리M <span>공략노트</span> <small>글쓰기</small></a>
    <nav id="wr-nav" hidden>
      <a href="#list">글 목록</a>
      <a href="#categories">분류 관리</a>
      <a href="#stats">방문 통계</a>
      <a href="/" target="_blank" rel="noopener">사이트 보기</a>
      <button type="button" id="logout" class="link">로그아웃</button>
    </nav>
    <ThemeToggle />
  </header>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

  <!-- 불러오는 중 (편집기 코드가 실행되지 않으면 이유를 보여 줌) -->
  <section id="view-loading" class="wr-wrap narrow">
    <p id="loading-msg" class="hint">불러오는 중…</p>
  </section>
  <script is:inline>
    (function () {
      var errs = [];
      window.addEventListener('error', function (e) { errs.push(e.message || String(e.error || '')); });
      window.addEventListener('unhandledrejection', function (e) { errs.push(String(e.reason && e.reason.message || e.reason)); });
      setTimeout(function () {
        if (window.__adminReady) return;
        var m = document.getElementById('loading-msg');
        if (!m) return;
        m.innerHTML = '글쓰기 화면을 불러오지 못했어요.<br>새로고침하거나 크롬, 사파리, 엣지 같은 기본 브라우저로 열어 주세요. 카카오톡 같은 앱 안의 브라우저에서는 안 될 수 있어요.' +
          (errs.length ? '<br><br><small>오류: ' + errs.join(' / ').replace(/</g, '&lt;') + '</small>' : '');
      }, 8000);
    })();
  </script>

  <!-- 로그인 -->
  <section id="view-login" class="wr-wrap narrow" hidden>
    <h1>로그인</h1>
    <form id="login-form" class="stack">
      <label for="password">관리자 비밀번호</label>
      <input id="password" type="password" autocomplete="current-password" required />
      <button class="primary" type="submit">로그인</button>
    </form>
  </section>

  <!-- 설정 전 -->
  <section id="view-setup" class="wr-wrap narrow" hidden>
    <h1>설정이 필요해요</h1>
    <p>Vercel 프로젝트의 환경 변수에 <code>ADMIN_PASSWORD</code>와 <code>GITHUB_TOKEN</code>을 넣고 다시 배포하면 글쓰기를 쓸 수 있어요.</p>
  </section>

  <!-- 글 목록 -->
  <section id="view-list" class="wr-wrap" hidden>
    <div class="row between">
      <h1>글 목록</h1>
      <a class="button primary" href="#new">새 글 쓰기</a>
    </div>
    <div class="row filters">
      <label for="filter-cat" class="sr">분류로 거르기</label>
      <select id="filter-cat"></select>
    </div>
    <ul id="post-list" class="wr-list"></ul>
  </section>

  <!-- 분류 관리 -->
  <section id="view-stats" class="wr-wrap wide" hidden>
    <div class="row between">
      <h1>방문 통계</h1>
      <div class="seg" id="st-range" role="group" aria-label="기간">
        <button type="button" data-r="today">오늘</button>
        <button type="button" data-r="yesterday">어제</button>
        <button type="button" data-r="7" class="on">7일</button>
        <button type="button" data-r="30">30일</button>
        <button type="button" data-r="90">90일</button>
      </div>
    </div>
    <div id="st-body"><p class="hint">불러오는 중…</p></div>
  </section>

  <section id="view-categories" class="wr-wrap" hidden>
    <div class="row between">
      <h1>분류 관리</h1>
      <button type="button" class="primary" id="cat-save">저장</button>
    </div>
    <p class="hint">위에서부터 메뉴 순서대로 보여요. 주소는 영문 소문자, 숫자, 하이픈(-)만 쓸 수 있어요.</p>
    <div id="cat-rows" class="cat-rows"></div>
    <button type="button" id="cat-add">분류 추가</button>
  </section>

  <!-- 글쓰기 -->
  <section id="view-editor" class="editor-page" hidden>
    <div class="ed-top">
      <a href="#list" class="back">← 목록</a>
      <span id="ed-state" class="hint"></span>
      <div class="row">
        <button type="button" id="ed-delete" class="danger" hidden>삭제</button>
        <button type="button" id="ed-save" class="primary">저장</button>
      </div>
    </div>

    <div class="ed-toolbar" role="toolbar" aria-label="편집 도구">
      <div class="tb-row tb-insert">
        <button type="button" data-cmd="image" title="사진"><span class="ic">▣</span>사진</button>
        <button type="button" data-cmd="quote" title="인용구"><span class="ic">❝</span>인용구</button>
        <button type="button" data-cmd="hr" title="구분선"><span class="ic">―</span>구분선</button>
        <button type="button" data-cmd="table" title="표"><span class="ic">▦</span>표</button>
        <button type="button" data-cmd="link" title="링크"><span class="ic">🔗︎</span>링크</button>
        <input type="file" id="image-input" accept="image/*" multiple hidden />
      </div>
      <div class="tb-row tb-format">
        <select id="tb-block" title="문단 스타일" aria-label="문단 스타일">
          <option value="p">본문</option>
          <option value="h2">소제목</option>
          <option value="h3">작은 소제목</option>
        </select>
        <select id="tb-size" title="글자 크기" aria-label="글자 크기">
          <option value="">크기</option>
          <option>11</option><option>13</option><option>15</option><option>16</option><option>19</option>
          <option>24</option><option>28</option><option>30</option><option>34</option><option>38</option>
        </select>
        <span class="sep"></span>
        <button type="button" data-cmd="bold" title="굵게"><b>B</b></button>
        <button type="button" data-cmd="italic" title="기울임"><i>I</i></button>
        <button type="button" data-cmd="underline" title="밑줄"><u>U</u></button>
        <button type="button" data-cmd="strike" title="취소선"><s>S</s></button>
        <span class="sep"></span>
        <div class="pop">
          <button type="button" data-pop="color" title="글자 색"><span class="swatch-a" id="color-mark">가</span></button>
          <div class="pop-panel" id="pop-color" hidden></div>
        </div>
        <div class="pop">
          <button type="button" data-pop="bg" title="글자 배경색"><span class="swatch-bg" id="bg-mark">가</span></button>
          <div class="pop-panel" id="pop-bg" hidden></div>
        </div>
        <span class="sep"></span>
        <button type="button" data-cmd="align-left" title="왼쪽 정렬">≡<small>왼</small></button>
        <button type="button" data-cmd="align-center" title="가운데 정렬">≡<small>가</small></button>
        <button type="button" data-cmd="align-right" title="오른쪽 정렬">≡<small>오</small></button>
        <button type="button" data-cmd="align-justify" title="양쪽 정렬">≡<small>양</small></button>
        <div class="pop">
          <button type="button" data-pop="space" title="줄 간격, 문단 간격, 글자 간격">↕<small>간격</small></button>
          <div class="pop-panel spacing" id="pop-space" hidden>
            <label>줄 간격
              <select id="sp-line">
                <option value="">기본</option><option value="1">1.0</option><option>1.2</option><option>1.5</option><option>1.8</option>
                <option value="2">2.0</option><option>2.5</option><option value="3">3.0</option>
              </select>
            </label>
            <label>문단 간격 <small>(아래쪽)</small>
              <select id="sp-para">
                <option value="">기본</option><option value="0px">0</option><option value="4px">4</option><option value="8px">8</option>
                <option value="16px">16</option><option value="24px">24</option><option value="32px">32</option><option value="48px">48</option>
              </select>
            </label>
            <label>글자 간격
              <select id="sp-letter">
                <option value="">기본</option><option value="-1px">-1</option><option value="-0.5px">-0.5</option><option value="0.5px">0.5</option>
                <option value="1px">1</option><option value="2px">2</option><option value="3px">3</option><option value="5px">5</option>
              </select>
            </label>
            <p class="hint">줄·문단 간격은 커서가 있는 문단(여러 문단을 고르면 모두)에, 글자 간격은 고른 글자에 적용돼요.</p>
          </div>
        </div>
        <span class="sep"></span>
        <button type="button" data-cmd="bullet" title="글머리 목록">•≡</button>
        <button type="button" data-cmd="ordered" title="번호 목록">1≡</button>
        <span class="sep"></span>
        <button type="button" data-cmd="undo" title="실행 취소">↶</button>
        <button type="button" data-cmd="redo" title="다시 실행">↷</button>
        <button type="button" data-cmd="clear" title="서식 지우기">서식 지우기</button>
      </div>
      <div class="tb-row tb-image" id="tb-image" hidden>
        <span class="hint">사진</span>
        <button type="button" data-cmd="img-w25">25%</button>
        <button type="button" data-cmd="img-w50">50%</button>
        <button type="button" data-cmd="img-w75">75%</button>
        <button type="button" data-cmd="img-w100">100%</button>
        <input type="range" id="img-range" min="10" max="100" step="5" value="100" aria-label="사진 크기" title="사진 크기" />
        <span id="img-size" class="hint">100%</span>
        <span class="sep"></span>
        <button type="button" data-cmd="img-left" title="왼쪽">≡<small>왼</small></button>
        <button type="button" data-cmd="img-center" title="가운데">≡<small>가</small></button>
        <button type="button" data-cmd="img-right" title="오른쪽">≡<small>오</small></button>
        <span class="sep"></span>
        <button type="button" data-cmd="img-edit" class="strong">✎ 사진 편집</button>
        <button type="button" data-cmd="img-alt">설명 글</button>
        <button type="button" data-cmd="img-del" class="danger-text">삭제</button>
      </div>
      <div class="tb-row tb-table" id="tb-table" hidden>
        <span class="hint">표</span>
        <button type="button" data-cmd="row-add">줄 추가</button>
        <button type="button" data-cmd="col-add">칸 추가</button>
        <button type="button" data-cmd="row-del">줄 삭제</button>
        <button type="button" data-cmd="col-del">칸 삭제</button>
        <button type="button" data-cmd="table-del" class="danger-text">표 삭제</button>
      </div>
    </div>

    <div class="ed-body">
      <label for="ed-title" class="sr">제목</label>
      <input id="ed-title" class="ed-title" placeholder="제목" autocomplete="off" />
      <details class="ed-meta" id="ed-meta">
        <summary>글 정보 (분류, 주소, 요약, 기준 패치)</summary>
        <div class="meta-grid">
          <label>분류 <select id="m-category"></select></label>
          <label>주소 <input id="m-slug" placeholder="level-route" pattern="[a-z0-9-]+" autocomplete="off" />
            <small>영문 소문자, 숫자, - 만. 글 주소 끝부분이 돼요.</small></label>
          <label class="wide">한 줄 요약 <input id="m-summary" placeholder="목록과 검색 결과에 보여요" /></label>
          <label>기준 패치 <input id="m-patch" placeholder="2026년 9월 정기 점검" /></label>
          <label>수정일 <input id="m-updated" type="date" /></label>
          <label>태그 <input id="m-tags" placeholder="쉼표로 구분: 뉴비, 200이전" /></label>
          <label>목록 순서 <input id="m-order" type="number" value="100" /><small>작을수록 위</small></label>
          <label class="check"><input id="m-draft" type="checkbox" /> 임시 저장 (사이트에 안 보임)</label>
        </div>
      </details>
      <div id="editor" class="prose ed-content"></div>
    </div>
  </section>

  <script>
    import '../../admin/app';
  </script>
</body>
</html>
