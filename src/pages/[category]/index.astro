---
import Base from '../../layouts/Base.astro';
import { getCategories, getPosts, postUrl, fmtDate } from '../../lib/site';

export async function getStaticPaths() {
  const categories = await getCategories();
  const posts = await getPosts();
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c, posts: posts.filter((p) => p.data.category === c.slug) },
  }));
}

const { category, posts } = Astro.props;
---
<Base title={`${category.name} 공략`} description={category.description || `메이플스토리M ${category.name} 공략 모음`} current={category.slug}>
  <p class="meta">분류</p>
  <h1>{category.name}</h1>
  {category.description && <p class="lead">{category.description}</p>}

  {posts.length === 0 ? (
    <p class="note">아직 공략이 없어요. 곧 채워질 예정입니다.</p>
  ) : (
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={postUrl(p)}>{p.data.title}</a>
          {p.data.summary && <span class="summary">{p.data.summary}</span>}
          <span class="meta">{fmtDate(p.data.updated)} 수정{p.data.patch && ` · ${p.data.patch} 기준`}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
