---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
import { sql } from '../../lib/server/db';
import { LIMITS, boardReady, canRead, ensureBoard } from '../../lib/server/board';
import { bdShort } from '../../lib/board-date';

export const prerender = false;

// 질문/의견 게시판 목록
const page = Math.max(1, Math.floor(Number(Astro.url.searchParams.get('page')) || 1));
let posts: any[] = [];
let notices: any[] = [];
let total = 0;
let error = '';
const ready = boardReady();
if (ready) {
  try {
    await ensureBoard();
    const db = sql();
    // 세 질문을 한꺼번에 보내고 답을 같이 기다립니다(하나씩 기다리는 것보다 빠름).
    let count: any[];
    [count, notices, posts] = await Promise.all([
      db`select count(*)::int as n from board_posts where not notice`,
      // 공지는 모든 쪽 맨 위에 고정
      db`select id, created, title, images, comments, views from board_posts where notice order by id desc`,
      db`
        select p.id, p.created, p.name, p.secret, p.title, p.images, p.comments, p.views,
               exists (select 1 from board_comments c where c.post_id = p.id and c.admin) as answered
        from board_posts p where not p.notice order by p.id desc
        limit ${LIMITS.perPage} offset ${(page - 1) * LIMITS.perPage}`,
    ]);
    total = count[0].n;
  } catch (e) {
    error = '게시판을 불러오지 못했어요. 잠시 뒤에 다시 열어 주세요.';
  }
}
const pages = Math.max(1, Math.ceil(total / LIMITS.perPage));
const from = Math.max(1, Math.min(page - 4, pages - 9));
const nums = Array.from({ length: Math.min(10, pages - from + 1) }, (_, i) => from + i);
const pageUrl = (n: number) => url(`/board/${n > 1 ? `?page=${n}` : ''}`);
Astro.response.headers.set('cache-control', 'no-store');
---
<Base title="질문/의견 게시판" description="메이플스토리M 공략노트에 궁금한 점이나 의견을 남겨 주세요." current="board">
  <div class="bd-top">
    <h1>질문/의견 게시판</h1>
    {ready && <a class="bd-btn primary" href={url('/board/write/')}>작성하기</a>}
  </div>
  <p class="lead">궁금한 점이나 사이트에 바라는 점을 남겨 주세요. 비밀글은 글쓴이와 관리자만 볼 수 있어요.</p>

  {!ready && <p class="bd-empty">게시판을 준비하고 있어요. 조금만 기다려 주세요.</p>}
  {error && <p class="bd-empty">{error}</p>}
  {ready && !error && posts.length === 0 && notices.length === 0 && <p class="bd-empty">아직 글이 없어요. 첫 글을 남겨 주세요.</p>}

  {(posts.length > 0 || notices.length > 0) && (
    <ul class="bd-list">
      {notices.map((p) => (
        <li class="bd-notice">
          <a href={url(`/board/${p.id}/`)}>
            <span class="bd-title">
              <span class="bd-tag">공지</span>
              <span class="t">{p.title}</span>
              {p.images > 0 && <span class="bd-pic" title={`사진 ${p.images}장`}>📷</span>}
              {p.comments > 0 && <span class="bd-cnt">[{p.comments}]</span>}
            </span>
            <span class="bd-meta">관리자 · {bdShort(p.created)}</span>
          </a>
        </li>
      ))}
      {posts.map((p) => (
        <li>
          <a href={url(`/board/${p.id}/`)} data-lock={p.secret && !canRead(Astro, p) ? p.id : undefined}>
            <span class="bd-title">
              {p.secret && <span class="bd-lock" title="비밀글">🔒</span>}
              <span class="t">{p.title}</span>
              {p.images > 0 && <span class="bd-pic" title={`사진 ${p.images}장`}>📷</span>}
              {p.comments > 0 && <span class="bd-cnt">[{p.comments}]</span>}
              {p.answered && <span class="bd-done">답변 완료</span>}
            </span>
            <span class="bd-meta">{p.name} · {bdShort(p.created)}</span>
          </a>
        </li>
      ))}
    </ul>
  )}

  {pages > 1 && (
    <nav class="bd-pages" aria-label="쪽 이동">
      {from > 1 && <a href={pageUrl(from - 1)} aria-label="이전 쪽">‹</a>}
      {nums.map((n) => <a href={pageUrl(n)} aria-current={n === page ? 'page' : undefined}>{n}</a>)}
      {nums[nums.length - 1] < pages && <a href={pageUrl(nums[nums.length - 1] + 1)} aria-label="다음 쪽">›</a>}
    </nav>
  )}

  <!-- 비밀글을 누르면 뜨는 비밀번호 창 -->
  <dialog id="bd-pw" class="bd-dialog" aria-labelledby="bd-pw-title">
    <form method="dialog" id="bd-pw-form">
      <h2 id="bd-pw-title">🔒 비밀글이에요</h2>
      <p>글을 쓸 때 넣은 비밀번호를 입력해 주세요.</p>
      <input type="password" name="pw" aria-label="비밀번호" placeholder="비밀번호" autocomplete="current-password" required />
      <p class="bd-msg" role="alert" hidden></p>
      <div class="bd-actions">
        <button type="button" class="bd-btn" value="cancel" id="bd-pw-cancel">취소</button>
        <button type="submit" class="bd-btn primary">열기</button>
      </div>
    </form>
  </dialog>
</Base>

<script define:vars={{ base: url('/') }}>
  (function () {
    var dlg = document.getElementById('bd-pw');
    var form = document.getElementById('bd-pw-form');
    var input = form.querySelector('[name=pw]');
    var msg = form.querySelector('.bd-msg');
    var target = null;
    var say = function (t) { msg.textContent = t; msg.hidden = !t; };
    document.querySelectorAll('a[data-lock]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        if (!dlg.showModal) return; // 오래된 브라우저는 글 화면에서 비밀번호를 받음
        e.preventDefault();
        target = a;
        input.value = '';
        say('');
        dlg.showModal();
        input.focus();
      });
    });
    document.getElementById('bd-pw-cancel').addEventListener('click', function () { dlg.close(); });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!input.value) return say('비밀번호를 입력해 주세요.');
      var btn = form.querySelector('[type=submit]');
      btn.disabled = true;
      fetch(base.replace(/\/$/, '') + '/api/board/unlock', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ id: Number(target.dataset.lock), pw: input.value }),
      }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (j) {
          if (!r.ok) throw new Error(j.error || '열지 못했어요.');
          location.href = target.href;
        });
      }).catch(function (err) { say(err.message); input.select(); })
        .finally(function () { btn.disabled = false; });
    });
  })();
</script>
