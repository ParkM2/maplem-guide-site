---
import Base from '../../layouts/Base.astro';
import CalcNav from '../../components/CalcNav.astro';
import '../../styles/calc.css';

// 메포 계산기: jin님 엑셀 '재화 계산기 (메포, 메소, 현금)'을 옮긴 것. 계산은 아래 script에서 브라우저가 합니다.
---
<Base title="메포 계산기" description="메이플스토리M 현금, 메소, 메포를 바꿀 때 드는 비용을 계산하고, 메소로 사는 것과 현금으로 사는 것 중 어느 쪽이 싼지 비교해요." current="calc">
  <div class="calc-page">
    <CalcNav current="mepo" />
  <div class="h1row"><h1>메포 계산기</h1><span class="h1-note">메소로 메포 구매하는 건 MVP 반영이 되지 않습니다.</span></div>

  <div class="pick">
    
    <select id="pick" aria-label="계산기 고르기">
      <option value="cm">현금 → 메소</option>
      <option value="mp">메소 → 메포</option>
      <option value="cmp">현금 → 메소 → 메포</option>
      <option value="cp">현금 → 메포</option>
      <option value="vs">메소 경유 vs 현금 결제 비교</option>
    </select>
  </div>

  <ul class="legend" aria-label="칸 색 설명">
    <li><i class="in"></i>입력하는 칸</li>
    <li><i class="f"></i>계산 결과</li>
    <li><i class="k"></i>고정값</li>
  </ul>

  <!-- 1. 현금 → 메소 -->
  <section class="calc" id="v-cm">
    <div class="blk">
      <div class="blk-h"><h2>현금 ↔ 메소</h2><span class="unit lb">거래 가격 (1억 메소당)<button class="tip" type="button" data-tip="meso" aria-label="거래 가격 설명">ⓘ</button></span><input class="c in" id="cm-price" inputmode="decimal" data-k="cmPrice"><span class="unit">원</span></div>
      <div class="row">
        <div class="tag">수수료 X</div>
        <div class="sent"><input class="c in" id="cm-want" inputmode="decimal" data-k="cmWant"><span>억 메소를 얻으려면</span><output class="c f" id="cm-x-won"></output><span>원 필요</span><span class="arrow">→</span><output class="c f" id="cm-x-buy"></output><span>억 메소 구매</span></div>
      </div>
      <div class="row">
        <div class="tag">수수료 O<small>메소 10%</small></div>
        <div class="sent"><output class="c f" id="cm-o-want"></output><span>억 메소를 얻으려면</span><output class="c f" id="cm-o-won"></output><span>원 필요</span><span class="arrow">→</span><output class="c f" id="cm-o-buy"></output><span>억 메소 구매</span></div>
      </div>
    </div>
  </section>

  <!-- 2. 메소 → 메포 -->
  <section class="calc" id="v-mp" hidden>
    <div class="blk">
      <div class="blk-h"><h2>메소 ↔ 메포</h2><span class="unit lb">거래 가격 (1억 메소당)<button class="tip" type="button" data-tip="mepo" aria-label="메포 거래 가격 설명">ⓘ</button></span><input class="c in" id="mp-price" inputmode="decimal" data-k="mpPrice"><span class="unit">Point</span></div>
      <div class="row">
        <div class="tag">수수료 X</div>
        <div class="sent"><input class="c in" id="mp-want" inputmode="decimal" data-k="mpWant"><span>Point를 얻으려면</span><output class="c f" id="mp-x-meso"></output><span>억 메소 필요</span><span class="arrow">→</span><output class="c f" id="mp-x-buy"></output><span>Point 구매</span></div>
      </div>
      <div class="row">
        <div class="tag">수수료 O<small>메포 1%</small></div>
        <div class="sent"><output class="c f" id="mp-o-want"></output><span>Point를 얻으려면</span><output class="c f" id="mp-o-meso"></output><span>억 메소 필요</span><span class="arrow">→</span><output class="c f" id="mp-o-buy"></output><span>Point 구매</span></div>
      </div>
    </div>
  </section>

  <!-- 3. 현금 → 메소 → 메포 -->
  <section class="calc" id="v-cmp" hidden>
    <div class="blk">
      <div class="blk-h"><h2>한눈에 보기</h2></div>
      <div class="sum">
        <span>메소를 억당</span><output class="c f" id="cmp-s-price"></output><span>원에 구매</span>
        <span>메포를 억당</span><output class="c f" id="cmp-s-rate"></output><span>Point에 구매</span>
        <span>메포를</span><output class="c f" id="cmp-s-want"></output><span>Point 구매 시</span>
        <span>현금</span><output class="c f" id="cmp-s-won"></output><span><b>원 필요</b></span>
        <output class="c cond" id="cmp-cond" hidden>메소 계산과 메포 계산의 메소 양이 같아야 해요</output>
      </div>
    </div>
    <div class="blk">
      <div class="blk-h"><h2>현금 ↔ 메소</h2><span class="unit lb">거래 가격 (1억 메소당)<button class="tip" type="button" data-tip="meso" aria-label="거래 가격 설명">ⓘ</button></span><input class="c in" id="cmp-price" inputmode="decimal" data-k="cmpPrice"><span class="unit">원</span></div>
      <div class="row">
        <div class="tag">수수료 X</div>
        <div class="sent"><output class="c f" id="cmp-x-meso"></output><span>억 메소를 얻으려면</span><output class="c f" id="cmp-x-won"></output><span>원 필요</span><span class="arrow">→</span><output class="c f" id="cmp-x-buy"></output><span>억 메소 구매</span></div>
      </div>
      <div class="row">
        <div class="tag">수수료 O<small>메소 10%</small></div>
        <div class="sent"><output class="c f" id="cmp-o-meso"></output><span>억 메소를 얻으려면</span><output class="c f" id="cmp-o-won"></output><span>원 필요</span><span class="arrow">→</span><output class="c f" id="cmp-o-buy"></output><span>억 메소 구매</span></div>
      </div>
    </div>
    <div class="blk">
      <div class="blk-h"><h2>메소 ↔ 메포</h2><span class="unit lb">거래 가격 (1억 메소당)<button class="tip" type="button" data-tip="mepo" aria-label="메포 거래 가격 설명">ⓘ</button></span><input class="c in" id="cmp-rate" inputmode="decimal" data-k="cmpRate"><span class="unit">Point</span></div>
      <div class="row">
        <div class="tag">수수료 X</div>
        <div class="sent"><input class="c in" id="cmp-want" inputmode="decimal" data-k="cmpWant"><span>Point를 얻으려면</span><output class="c f" id="cmp-mx-meso"></output><span>억 메소 필요</span><span class="arrow">→</span><output class="c f" id="cmp-mx-buy"></output><span>Point 구매</span></div>
      </div>
      <div class="row">
        <div class="tag">수수료 O<small>메포 1%</small></div>
        <div class="sent"><output class="c f" id="cmp-mo-want"></output><span>Point를 얻으려면</span><output class="c f" id="cmp-mo-meso"></output><span>억 메소 필요</span><span class="arrow">→</span><output class="c f" id="cmp-mo-buy"></output><span>Point 구매</span></div>
      </div>
    </div>
    <p class="calc-note">메포 수수료까지 넣은 메소 양을 억 단위로 반올림해서 위의 메소 계산에 넘겨요.</p>
  </section>

  <!-- 4. 현금 → 메포 -->
  <section class="calc" id="v-cp" hidden>
    <div class="blk">
      <div class="blk-h"><h2>현금 → 메포</h2></div>
      <div class="stack">
        <div class="ln"><span class="unit">계산할 메포</span><div class="seg" role="radiogroup" aria-label="메포 양 고르기" data-want="cpWant"><button type="button" role="radio" data-v="12000">12,000</button><button type="button" role="radio" data-v="33000">33,000</button></div><span class="unit">메포</span></div>
        <div class="ln"><span class="unit lb">결제 할인<button class="tip" type="button" data-tip="disc" aria-label="결제 할인 설명">ⓘ</button></span><input class="c in" id="cp-disc" inputmode="decimal" data-k="cpDisc"><span class="unit">%</span></div>
        <div class="ln"><label class="chk"><input type="checkbox" id="cp-use-pp" data-chk="cpUsePp">구글 플포 사용</label></div>
        <div class="pp-box" id="cp-pp-box">
          <div class="ln"><span class="unit lb">플포 비율 (1포인트당)<button class="tip" type="button" data-tip="pp" aria-label="플포 비율 설명">ⓘ</button></span><input class="c in" id="cp-pp" inputmode="decimal" data-k="cpPp"><span class="unit">원</span></div>
          <div class="ln"><span class="unit lb">할인 방법<button class="tip" type="button" data-tip="method" aria-label="할인 방법 설명">ⓘ</button></span><select class="c in sel" id="cp-method" data-sel="cpMethod" aria-label="할인 방법">
            <option value="p150">150포</option><option value="p750">750포</option><option value="p1200">1200포</option><option value="w50">50% 주간 (₩6,500)</option>
          </select></div>
          <div class="kgrid">
            <span class="unit">쓰는 플포</span><output class="c k" id="cp-k-pp"></output>
            <span class="unit">할인 금액</span><output class="c k" id="cp-k-off"></output>
            <span class="unit">쓸 수 있는 상품</span><output class="c k" id="cp-k-min"></output>
          </div>
        </div>
      </div>
    </div>
    <div class="grid2">
      <div class="blk" id="cp-p-card">
        <div class="blk-h"><h2 id="cp-p-h"></h2></div>
        <div class="stack">
          <div class="ln"><output class="c f" id="cp-p-cost"></output><span>원에 구매</span></div>
          <div class="ln"><span>1메포</span><span class="arrow">=</span><output class="c f" id="cp-p-unit"></output><span>원</span></div>
        </div>
      </div>
      <output class="c cond cp-warn" id="cp-p-warn" hidden></output>
      <div class="blk" id="cp-d-card">
        <div class="blk-h"><h2 id="cp-d-h"></h2></div>
        <div class="stack">
          <div class="ln"><output class="c f" id="cp-d-cost"></output><span>원에 구매</span></div>
          <div class="ln"><span>1메포</span><span class="arrow">=</span><output class="c f" id="cp-d-unit"></output><span>원</span></div>
        </div>
      </div>
    </div>
    <p class="calc-note">플포 쿠폰은 한 번 결제에 하나만 쓸 수 있어요. 쿠폰은 할인 금액 이상인 상품에만 쓸 수 있어요.</p>
  </section>

  <!-- 5. 메소 경유 vs 현금 결제 비교 -->
  <section class="calc" id="v-vs" hidden>
    <div class="blk">
      <div class="blk-h"><h2>같은 메포, 어떻게 사는 게 쌀까?</h2></div>
      <div class="stack">
        <div class="ln"><span class="unit lb">메소 거래 가격 (1억 메소당)<button class="tip" type="button" data-tip="meso" aria-label="메소 거래 가격 설명">ⓘ</button></span><input class="c in" id="vs-price" inputmode="decimal" data-k="vsPrice"><span class="unit">원</span></div>
        <div class="ln"><span class="unit lb">결제 할인<button class="tip" type="button" data-tip="disc" aria-label="결제 할인 설명">ⓘ</button></span><input class="c in" id="vs-disc" inputmode="decimal" data-k="vsDisc"><span class="unit">%</span></div>
        <div class="ln"><label class="chk"><input type="checkbox" id="vs-use-pp" data-chk="vsUsePp">구글 플포 사용</label></div>
        <div class="pp-box" id="vs-pp-box">
          <div class="ln"><span class="unit lb">플포 비율 (1포인트당)<button class="tip" type="button" data-tip="pp" aria-label="플포 비율 설명">ⓘ</button></span><input class="c in" id="vs-pp" inputmode="decimal" data-k="vsPp"><span class="unit">원</span></div>
          <div class="ln"><span class="unit lb">할인 방법<button class="tip" type="button" data-tip="method" aria-label="할인 방법 설명">ⓘ</button></span><select class="c in sel" id="vs-method" data-sel="vsMethod" aria-label="할인 방법">
            <option value="p150">150포</option><option value="p750">750포</option><option value="p1200">1200포</option><option value="w50">50% 주간 (₩6,500)</option>
          </select></div>
          <div class="kgrid">
            <span class="unit">쓰는 플포</span><output class="c k" id="vs-k-pp"></output>
            <span class="unit">할인 금액</span><output class="c k" id="vs-k-off"></output>
            <span class="unit">쓸 수 있는 상품</span><output class="c k" id="vs-k-min"></output>
          </div>
        </div>
        <div class="ln total"><span class="unit">비교할 메포</span><div class="seg" role="radiogroup" aria-label="메포 양 고르기" data-want="vsWant"><button type="button" role="radio" data-v="12000">12,000</button><button type="button" role="radio" data-v="33000">33,000</button></div><span class="unit">메포</span></div>
      </div>
    </div>
    <div class="blk">
      <div class="vs-head">
        <div class="vs-side" id="vs-a"><span class="lbl">현금 → 메소 → 메포</span><output class="c f" id="vs-a-won"></output><span class="how" id="vs-a-how"></span></div>
        <div class="vs-side" id="vs-b"><span class="lbl">현금 결제 (가장 싼 방법)</span><output class="c f" id="vs-b-won"></output><span class="how" id="vs-b-how"></span></div>
      </div>
      <output class="c cond vs-verdict" id="vs-verdict"></output>
      <output class="c cond vs-verdict" id="vs-pp-warn" hidden></output>
      <ul class="vs-list" id="vs-list" aria-label="방법별 비용"></ul>
    </div>
    <p class="calc-note">메소 경유는 메포 수수료 1%와 메소 수수료 10%를 넣은 값이에요. 플포 쿠폰은 할인 금액 이상인 상품에만 쓸 수 있어요.</p>
  </section>
    <div class="tip-pop" id="tip-pop" role="tooltip" hidden></div>
  </div>
</Base>

<script>
(function () {
  // jin님 엑셀 '재화 계산기 (메포, 메소, 현금)'과 같은 식. 수수료 배수는 엑셀 그대로 1.11, 1.01
  var MESO_FEE = 1.11, MEPO_FEE = 1.01;
  // 구글 플포 할인 방법 (고정값, 회색 칸). 쿠폰은 할인 금액 이상인 상품에만 쓸 수 있어요.
  // 50% 주간은 플포를 쓰지 않고 상품 금액의 50%를 최대 6,500원까지 할인
  var METHODS = {
    p150: { name: '150플포 쿠폰', pp: 150, off: 3000 },
    p750: { name: '750플포 쿠폰', pp: 750, off: 15000 },
    p1200: { name: '1200플포 쿠폰', pp: 1200, off: 25000 },
    w50: { name: '50% 주간 할인', pp: 0, rate: 0.5, max: 6500 }
  };
  // 상품 금액(원) = 메포 양. 쓸 수 없으면 null
  function ppCost(m, price, ppWon) {
    if (m.rate) return price - Math.min(price * m.rate, m.max);
    if (price < m.off) return null;
    return m.pp * ppWon + (price - m.off);
  }
  function fillMethod(pre, m) {
    $(pre + '-k-pp').textContent = m.pp ? fmt(m.pp) : '-';
    $(pre + '-k-off').textContent = m.rate ? '50% (최대 ' + fmt(m.max) + ')' : fmt(m.off);
    $(pre + '-k-min').textContent = m.rate ? '모든 상품' : fmt(m.off) + '원 이상';
  }
  var DEF = { cmPrice: 650, cmWant: 13, mpPrice: 900, mpWant: 10000, cmpPrice: 650, cmpRate: 1000, cmpWant: 50000, cpDisc: 5, cpUsePp: false, cpPp: 10, cpMethod: 'p1200', cpWant: 33000, vsPrice: 650, vsRate: 1000, vsDisc: 5, vsUsePp: false, vsPp: 10, vsMethod: 'p1200', vsWant: 33000, view: 'cm' };
  var KEY = 'mgs_calc_v2';
  var st = Object.assign({}, DEF);
  try { Object.assign(st, JSON.parse(localStorage.getItem(KEY) || '{}')); } catch (e) {}
  var save = function () { try { localStorage.setItem(KEY, JSON.stringify(st)); } catch (e) {} };

  var $ = function (id) { return document.getElementById(id); };
  var n = function (v) { v = Number(String(v).replace(/,/g, '')); return isFinite(v) && v > 0 ? v : 0; };
  var fmt = function (v, d) { return v.toLocaleString('ko-KR', { maximumFractionDigits: d || 0 }); };
  var put = function (id, v, d) { $(id).textContent = fmt(v, d); };

  // 메포 양은 12,000 / 33,000 중 하나만 고릅니다
  var WANTS = [12000, 33000];
  ['cpWant', 'vsWant'].forEach(function (k) { if (WANTS.indexOf(Number(st[k])) < 0) st[k] = 33000; });
  document.querySelectorAll('.seg').forEach(function (box) {
    var k = box.dataset.want, btns = box.querySelectorAll('button');
    var mark = function () { btns.forEach(function (b) { b.setAttribute('aria-checked', Number(b.dataset.v) === Number(st[k])); }); };
    btns.forEach(function (b) { b.addEventListener('click', function () { st[k] = Number(b.dataset.v); save(); mark(); calc(); }); });
    mark();
  });

  var inputs = document.querySelectorAll('input[data-k]');
  inputs.forEach(function (el) {
    el.value = fmt(n(st[el.dataset.k]), 4);
    el.addEventListener('input', function () { st[el.dataset.k] = el.value; save(); calc(); });
    el.addEventListener('focus', function () { el.select(); });
    el.addEventListener('blur', function () { el.value = fmt(n(el.value), 4); });
  });
  // 구글 플포 사용 체크박스, 할인 방법 콤보 박스
  document.querySelectorAll('input[data-chk]').forEach(function (el) {
    el.checked = !!st[el.dataset.chk];
    el.addEventListener('change', function () { st[el.dataset.chk] = el.checked; save(); calc(); });
  });
  document.querySelectorAll('select[data-sel]').forEach(function (el) {
    if (!METHODS[st[el.dataset.sel]]) st[el.dataset.sel] = 'p1200';
    el.value = st[el.dataset.sel];
    el.addEventListener('change', function () { st[el.dataset.sel] = el.value; save(); calc(); });
  });

  var pick = $('pick');
  function show(v) {
    ['cm', 'mp', 'cmp', 'cp', 'vs'].forEach(function (k) { $('v-' + k).hidden = k !== v; });
    pick.value = v; st.view = v; save();
  }
  pick.addEventListener('change', function () { show(pick.value); });

  function calc() {
    // 1. 현금 → 메소
    var p = n(st.cmPrice), w = n(st.cmWant);
    put('cm-x-won', p * w); put('cm-x-buy', w, 2);
    put('cm-o-want', w, 2); put('cm-o-buy', w * MESO_FEE, 2); put('cm-o-won', p * w * MESO_FEE);

    // 2. 메소 → 메포
    var r = n(st.mpPrice), pt = n(st.mpWant);
    put('mp-x-meso', r ? pt / r : 0, 2); put('mp-x-buy', pt);
    put('mp-o-want', pt); put('mp-o-buy', pt * MEPO_FEE, 2); put('mp-o-meso', r ? pt * MEPO_FEE / r : 0, 2);

    // 3. 현금 → 메소 → 메포: 메포 칸의 메소 양(반올림)이 메소 칸으로 넘어갑니다
    var cp = n(st.cmpPrice), cr = n(st.cmpRate), cw = n(st.cmpWant);
    var meso = cr ? Math.round(cw * MEPO_FEE / cr) : 0;
    put('cmp-mx-meso', cr ? cw / cr : 0, 2); put('cmp-mx-buy', cw);
    put('cmp-mo-want', cw); put('cmp-mo-buy', cw * MEPO_FEE, 2); put('cmp-mo-meso', meso);
    put('cmp-x-meso', meso); put('cmp-x-won', cp * meso); put('cmp-x-buy', meso);
    put('cmp-o-meso', meso); put('cmp-o-buy', meso * MESO_FEE, 2); put('cmp-o-won', cp * meso * MESO_FEE);
    put('cmp-s-price', cp); put('cmp-s-rate', cr); put('cmp-s-want', cw); put('cmp-s-won', cp * meso * MESO_FEE);

    // 4. 현금 → 메포 (상품 금액 = 메포 양)
    var d = n(st.cpDisc) / 100, mw = n(st.cpWant);
    var cm = METHODS[st.cpMethod] || METHODS.p1200;
    $('cp-pp-box').hidden = !st.cpUsePp;
    fillMethod('cp', cm);
    $('cp-d-h').textContent = fmt(mw) + '메포 직접 결제';
    put('cp-d-cost', mw * (1 - d)); put('cp-d-unit', 1 - d, 3);
    var pc = ppCost(cm, mw, n(st.cpPp));
    $('cp-p-card').hidden = !st.cpUsePp || pc === null;
    $('cp-p-warn').hidden = !st.cpUsePp || pc !== null;
    $('cp-p-warn').textContent = cm.name + '은 ' + fmt(cm.off || 0) + '원 이상 상품에만 쓸 수 있어서 ' + fmt(mw) + '메포 상품에는 못 써요.';
    if (pc !== null) {
      $('cp-p-h').textContent = cm.name + ' → ' + fmt(mw) + '메포';
      put('cp-p-cost', pc); put('cp-p-unit', mw ? pc / mw : 0, 3);
    }

    // 5. 메소 경유 vs 현금 결제
    var vp = n(st.vsPrice), vr = n(st.vsRate), vd = n(st.vsDisc) / 100, vw = n(st.vsWant);
    var vm = METHODS[st.vsMethod] || METHODS.p1200;
    $('vs-pp-box').hidden = !st.vsUsePp;
    fillMethod('vs', vm);
    var vMeso = vr ? Math.round(vw * MEPO_FEE / vr) : 0;
    var ways = [{ grp: '메소 경유', name: '현금 → 메소 → 메포', cost: vp * vMeso * MESO_FEE, how: fmt(vMeso * MESO_FEE, 2) + '억 메소 구매 → ' + fmt(vMeso) + '억 메소로 메포 교환', a: true }];
    var vpc = st.vsUsePp ? ppCost(vm, vw, n(st.vsPp)) : null;
    if (vpc !== null) ways.push({ grp: '구글 플포', name: vm.name, cost: vpc, how: vm.pp ? fmt(vm.pp) + '플포 사용, ' + fmt(vm.off) + '원 할인' : fmt(Math.min(vw * vm.rate, vm.max)) + '원 할인' });
    $('vs-pp-warn').hidden = !st.vsUsePp || vpc !== null;
    $('vs-pp-warn').textContent = vm.name + '은 ' + fmt(vm.off || 0) + '원 이상 상품에만 쓸 수 있어서 비교에서 뺐어요.';
    ways.push({ grp: '현금 결제', name: '직접 결제', cost: (1 - vd) * vw, how: '결제 할인 ' + fmt(vd * 100, 2) + '% 적용' });
    var A = ways[0], B = ways.slice(1).sort(function (x, y) { return x.cost - y.cost; })[0];
    $('vs-a-won').textContent = fmt(A.cost) + '원'; $('vs-a-how').textContent = '1메포당 ' + fmt(vw ? A.cost / vw : 0, 3) + '원';
    $('vs-b-won').textContent = fmt(B.cost) + '원'; $('vs-b-how').textContent = B.name + ', 1메포당 ' + fmt(vw ? B.cost / vw : 0, 3) + '원';
    var diff = Math.round(Math.abs(A.cost - B.cost));
    $('vs-a').classList.toggle('win', A.cost < B.cost);
    $('vs-b').classList.toggle('win', B.cost < A.cost);
    $('vs-verdict').textContent = !vw ? '비교할 메포를 넣어 주세요.' : diff === 0 ? '두 방법의 비용이 같아요.'
      : A.cost < B.cost ? '현금 → 메소 → 메포가 ' + fmt(diff) + '원 더 싸요.'
      : '현금 → 메포(' + B.name + ')가 ' + fmt(diff) + '원 더 싸요.';
    var low = Math.min.apply(null, ways.map(function (x) { return x.cost; }));
    $('vs-list').innerHTML = ways.slice().sort(function (x, y) { return x.cost - y.cost; }).map(function (x) {
      return '<li><span class="nm">' + x.name + ' <span class="grp">' + x.grp + '</span>' + (vw && x.cost === low ? ' <span class="best">가장 저렴</span>' : '') + '</span>' +
        '<output class="c f">' + fmt(x.cost) + '원</output><span class="sub">' + x.how + '</span></li>';
    }).join('');
  }


  // ⓘ 설명: PC는 마우스를 올리면 보이고 벗어나면 사라짐, 모바일은 누르면 보이고 다른 곳을 누르면 사라짐
  var TIPS = {
    meso: '메소와 현금 거래 비율입니다. 1:600이라면 1억 메소가 현금 600원입니다.',
    disc: '문상 6% 할인, MC 5% 적립 등 직접 결제 시 할인받는 비율을 넣어요. 직접 결제에만 적용돼요.',
    method: '150포는 3,000원 할인(3,000원 이상 상품), 750포는 15,000원 할인(15,000원 이상 상품), 1200포는 25,000원 할인(25,000원 이상 상품), 50% 주간은 상품 금액의 50%를 최대 6,500원까지 할인해요.',
    mepo: '메포 구매라면, 메소마켓의 메소 판매 탭 가격이에요. 예를 들어 1억 메소당 메이플 포인트가 1,000일 때, 10억 메소를 판매하면 수수료 1%가 차감된 9,900메포가 들어와요.',
    pp: '구글 플레이 포인트 현금 거래 비율입니다. 1:10의 경우 플포 1이 현금 10원입니다. 1:12는 플포 1이 현금 12원입니다.'
  };
  var pop = $('tip-pop'), cur = null;
  function showTip(b) {
    if (cur && cur !== b) cur.setAttribute('aria-expanded', 'false');
    cur = b; b.setAttribute('aria-expanded', 'true'); b.setAttribute('aria-describedby', 'tip-pop');
    pop.textContent = TIPS[b.dataset.tip]; pop.hidden = false;
    var r = b.getBoundingClientRect(), w = pop.offsetWidth, h = pop.offsetHeight;
    var left = Math.min(Math.max(12, r.left + r.width / 2 - w / 2), innerWidth - w - 12);
    var top = r.top - h - 8; if (top < 12) top = r.bottom + 8;
    pop.style.left = left + 'px'; pop.style.top = top + 'px';
  }
  function hideTip() {
    if (cur) { cur.setAttribute('aria-expanded', 'false'); cur.removeAttribute('aria-describedby'); }
    cur = null; pop.hidden = true;
  }
  document.querySelectorAll('.tip').forEach(function (b) {
    b.setAttribute('aria-expanded', 'false');
    b.addEventListener('pointerenter', function (e) { if (e.pointerType === 'mouse') showTip(b); });
    b.addEventListener('pointerleave', function (e) { if (e.pointerType === 'mouse') hideTip(); });
    b.addEventListener('focus', function () { if (b.matches(':focus-visible')) showTip(b); });
    b.addEventListener('blur', hideTip);
    b.addEventListener('click', function (e) { e.stopPropagation(); if (cur === b && e.pointerType !== 'mouse') hideTip(); else showTip(b); });
  });
  document.addEventListener('click', function () { if (cur) hideTip(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') hideTip(); });
  addEventListener('scroll', function () { if (cur) hideTip(); }, { passive: true });
  addEventListener('resize', hideTip);

  show(['cm', 'mp', 'cmp', 'cp', 'vs'].indexOf(st.view) >= 0 ? st.view : 'cm');
  calc();
})();
</script>
