---
import Base from '../layouts/Base.astro';
import HomeMap from '../components/HomeMap.astro';
import { SITE_NAME, getCategories, getPosts, postUrl, url, fmtDate } from '../lib/site';

const categories = await getCategories();
const posts = await getPosts();
const recent = [...posts].sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()).slice(0, 5);
---
<Base>
  <!-- 첫 화면의 가장 큰 그림을 먼저 받도록 브라우저에 알려 줍니다. -->
  <link slot="head" rel="preload" as="image" href={url('/home/keyart.webp')} type="image/webp" fetchpriority="high" />
  <HomeMap slot="hero" categories={categories} />
  <h1 class="sr">{SITE_NAME}</h1>

  {recent.length > 0 && (
    <section>
      <h2>최근 수정된 공략</h2>
      <ul class="post-list">
        {recent.map((p) => (
          <li>
            <a href={postUrl(p)}>
              <span class="title">{p.data.title}</span>
              <span class="meta">{categories.find((c) => c.slug === p.data.category)?.name} · {fmtDate(p.data.updated)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
