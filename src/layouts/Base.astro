---
import '../styles/global.css';
import { SITE_NAME, SITE_DESC, getCategories, url } from '../lib/site';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteSearch from '../components/SiteSearch.astro';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  // 공략 글: 키워드(해시태그)와 날짜를 검색엔진이 읽을 수 있게 넣습니다.
  article?: { keywords: string[]; modified: Date; section?: string };
  // 카카오톡, 네이버 등에 링크를 공유할 때 보이는 미리보기 사진 (없으면 첫 화면 대표 그림)
  image?: string;
  // 검색 결과에 나오지 않아야 하는 페이지 (404, 검색 결과 화면)
  noindex?: boolean;
}
const { title, description = SITE_DESC, current, article, image = url('/home/keyart.jpg'), noindex } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
// 구글 서치 콘솔, 네이버 서치어드바이저 소유 확인 코드 (Vercel 환경 변수에 넣으면 자동으로 붙습니다)
// 구글 서치 콘솔 확인 코드: 예전 vercel.app 주소용 + 새 도메인(maplem-guide.co.kr)용
const googleVerify = process.env.GOOGLE_SITE_VERIFICATION
  ? [process.env.GOOGLE_SITE_VERIFICATION]
  : ['OpqwGAufo8fhKOXIiACfRUIT5mphYU_-Lo6WDW8lTqg', 'sZnnN_BX-p5WLxQzaMrLCs8tMBuLkv5--JMH1s7qBI4'];
// 네이버 서치어드바이저 확인 코드: 예전 vercel.app 주소용 + 새 도메인용
const naverVerify = process.env.NAVER_SITE_VERIFICATION
  ? [process.env.NAVER_SITE_VERIFICATION]
  : ['a44b94690a02b3cba9a0ab63727d13d7a89eebdb', '9f52978e655f4af4d74a90075ebfdf82aa1e2c74'];
const categories = await getCategories();
const FONT_CSS = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap';
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <ThemeHead />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  {googleVerify.map((code) => <meta name="google-site-verification" content={code} />)}
  {naverVerify.map((code) => <meta name="naver-site-verification" content={code} />)}
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="ko_KR" />
  {article && article.keywords.length > 0 && <meta name="keywords" content={article.keywords.join(', ')} />}
  {article && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  {article?.section && <meta property="article:section" content={article.section} />}
  {article?.keywords.map((k) => <meta property="article:tag" content={k} />)}
  {article && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      keywords: article.keywords.join(', '),
      dateModified: article.modified.toISOString(),
      articleSection: article.section,
      inLanguage: 'ko',
      mainEntityOfPage: canonical,
      image: ogImage,
      publisher: { '@type': 'Organization', name: SITE_NAME },
    }).replace(/</g, '\\u003c')} />
  )}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={url('/rss.xml')} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <!-- 글꼴: 구글 폰트를 화면 표시를 막지 않게 불러옵니다. 글꼴이 오기 전에는 기본 글꼴로 먼저 보여 줍니다. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href={FONT_CSS} />
  <link rel="stylesheet" href={FONT_CSS} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>
  <slot name="head" />
</head>
<body class="site">
  <header class="site-head">
    <div class="wrap">
      <a class="logo" href={url('/')}>메이플스토리M <span>공략노트</span></a>
      <nav class="site-nav" aria-label="공략 분류">
        {categories.map((c) => (
          <a href={url(`/${c.slug}/`)} aria-current={current === c.slug ? 'page' : undefined}>{c.name}</a>
        ))}
        <a href={url('/calc/')} class="qna-link" aria-current={current === 'calc' ? 'page' : undefined}>계산기</a>
        <a href={url('/board/')} class="qna-link" aria-current={current === 'board' ? 'page' : undefined}>질문/의견 게시판</a>
      </nav>
      <div class="head-tools">
        <SiteSearch />
        <ThemeToggle />
      </div>
    </div>
  </header>
  <slot name="hero" />
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <p>{SITE_NAME}는 팬이 만든 비공식 사이트입니다. 메이플스토리M의 권리는 넥슨에 있습니다.</p>
      <p><a href={url('/about/')}>사이트 소개</a></p>
    </div>
  </footer>
  <script is:inline>
    // 방문 통계: 이름, IP 같은 개인정보 없이 무작위 번호로만 방문을 셉니다.
    (function () {
      try {
        var api = '/api/seen', now = Date.now();
        var rid = function () { return (Math.random().toString(36).slice(2) + now.toString(36)).slice(0, 20); };
        var get = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
        var set = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
        var vid = get('mgs_vid'), nv = !vid;
        if (!vid) { vid = rid(); set('mgs_vid', vid); }
        // 30분 넘게 쉬었다 오면 새 방문으로 셉니다.
        var s = (get('mgs_sid') || '').split('.'), sid = s[0], ns = !sid || now - Number(s[1] || 0) > 30 * 60 * 1000;
        if (ns) sid = rid();
        set('mgs_sid', sid + '.' + now);
        var pid = rid(), shown = now, spent = 0;
        var send = function (data) {
          var body = JSON.stringify(data);
          if (navigator.sendBeacon) navigator.sendBeacon(api, new Blob([body], { type: 'application/json' }));
          else fetch(api, { method: 'POST', body: body, keepalive: true, headers: { 'content-type': 'application/json' } });
        };
        var utm = new URLSearchParams(location.search).get('utm_source');
        send({ t: 'pv', pid: pid, vid: vid, sid: sid, nv: nv, ns: ns, path: location.pathname, ref: document.referrer, utm: utm });
        var flush = function () {
          if (shown) { spent += Date.now() - shown; shown = 0; }
          if (spent > 500) send({ t: 'dur', pid: pid, dur: Math.round(spent / 1000) });
        };
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') flush(); else { shown = Date.now(); set('mgs_sid', sid + '.' + Date.now()); }
        });
        addEventListener('pagehide', flush);
      } catch (e) {}
    })();
  </script>
</body>
</html>
