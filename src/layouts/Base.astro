---
import '../styles/global.css';
import { SITE_NAME, SITE_DESC, getCategories, url } from '../lib/site';
import ThemeHead from '../components/ThemeHead.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SiteSearch from '../components/SiteSearch.astro';

interface Props { title?: string; description?: string; current?: string }
const { title, description = SITE_DESC, current } = Astro.props;
const categories = await getCategories();
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <ThemeHead />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" />
</head>
<body class="site">
  <header class="site-head">
    <div class="wrap">
      <a class="logo" href={url('/')}>메이플스토리M <span>공략노트</span></a>
      <nav class="site-nav" aria-label="공략 분류">
        {categories.map((c) => (
          <a href={url(`/${c.slug}/`)} aria-current={current === c.slug ? 'page' : undefined}>{c.name}</a>
        ))}
      </nav>
      <div class="head-tools">
        <SiteSearch />
        <ThemeToggle />
      </div>
    </div>
  </header>
  <slot name="hero" />
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <p>{SITE_NAME}는 팬이 만든 비공식 사이트입니다. 메이플스토리M의 권리는 넥슨에 있습니다.</p>
      <p><a href={url('/about/')}>사이트 소개</a></p>
    </div>
  </footer>
  <script is:inline>
    // 방문 통계: 이름, IP 같은 개인정보 없이 무작위 번호로만 방문을 셉니다.
    (function () {
      try {
        var api = '/api/seen', now = Date.now();
        var rid = function () { return (Math.random().toString(36).slice(2) + now.toString(36)).slice(0, 20); };
        var get = function (k) { try { return localStorage.getItem(k); } catch (e) { return null; } };
        var set = function (k, v) { try { localStorage.setItem(k, v); } catch (e) {} };
        var vid = get('mgs_vid'), nv = !vid;
        if (!vid) { vid = rid(); set('mgs_vid', vid); }
        // 30분 넘게 쉬었다 오면 새 방문으로 셉니다.
        var s = (get('mgs_sid') || '').split('.'), sid = s[0], ns = !sid || now - Number(s[1] || 0) > 30 * 60 * 1000;
        if (ns) sid = rid();
        set('mgs_sid', sid + '.' + now);
        var pid = rid(), shown = now, spent = 0;
        var send = function (data) {
          var body = JSON.stringify(data);
          if (navigator.sendBeacon) navigator.sendBeacon(api, new Blob([body], { type: 'application/json' }));
          else fetch(api, { method: 'POST', body: body, keepalive: true, headers: { 'content-type': 'application/json' } });
        };
        var utm = new URLSearchParams(location.search).get('utm_source');
        send({ t: 'pv', pid: pid, vid: vid, sid: sid, nv: nv, ns: ns, path: location.pathname, ref: document.referrer, utm: utm });
        var flush = function () {
          if (shown) { spent += Date.now() - shown; shown = 0; }
          if (spent > 500) send({ t: 'dur', pid: pid, dur: Math.round(spent / 1000) });
        };
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') flush(); else { shown = Date.now(); set('mgs_sid', sid + '.' + Date.now()); }
        });
        addEventListener('pagehide', flush);
      } catch (e) {}
    })();
  </script>
</body>
</html>
